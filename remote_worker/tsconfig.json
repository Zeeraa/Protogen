{
    "compilerOptions": {
        "target": "ES6",
        "module": "Node16",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "noImplicitAny": true,
        "skipLibCheck": true,
        "rootDir": "./src",
        "outDir": "dist",
        "sourceMap": true,
        "moduleResolution": "Node16",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "strictPropertyInitialization": false,
        "types": ["node"],
    },
    "include": [
        "src/**/*"
    ]
}